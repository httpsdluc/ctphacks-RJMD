{
  "name": "thinkpad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI coding coach that teaches instead of answering. Chrome MV3 side panel.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types server/lib/*.test.ts",
    "dry-run": "node --experimental-strip-types server/dryrun.ts",
    "smoke": "node --experimental-strip-types --env-file=.env server/smoke.ts",
    "eval": "node --experimental-strip-types --env-file=.env server/eval.ts"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4"
  }
}

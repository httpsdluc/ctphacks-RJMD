{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "types": ["chrome"],
    "paths": {
      "@shared/*": ["./shared/*"],
      "@fixtures/*": ["./fixtures/*"],
      "@visuals/*": ["./visuals/*"]
    }
  },
  "include": ["shared", "extension", "panel", "visuals", "server"]
}
